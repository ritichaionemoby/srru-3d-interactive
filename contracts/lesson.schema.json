{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-lesson/lesson-meta.schema.json",
  "title": "Github metadata",
  "description": "Schema สำหรับตรวจ metadata หลัง registration; ไม่ใช่ schema ของ HTML ทั้งไฟล์",
  "type": "object",
  "required": ["id", "version", "meta"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+].*)?$" },
    "meta": {
      "type": "object",
      "required": ["worldType", "lessonId", "title", "category", "subcategory", "description", "keyResult", "defaultValue", "editSchema", "howto", "quiz"],
      "properties": {
        "worldType": { "const": "3d-world-space" },
        "lessonId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "subcategory": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "keyResult": { "type": "string" },
        "background": { "type": "string" },
        "camera": {
          "type": "object",
          "properties": {
            "fov": { "type": "number" },
            "startYaw": { "type": "number" },
            "startPitch": { "type": "number" },
            "startDistance": { "type": "number" },
            "minDistance": { "type": "number" },
            "maxDistance": { "type": "number" },
            "minPitch": { "type": "number" },
            "maxPitch": { "type": "number" },
            "target": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "additionalProperties": false
        },
        "welcomeMessage": { "type": "array", "items": { "type": "string" } },
        "tooltip": { "type": "string" },
        "defaultValue": { "type": "object" },
        "editSchema": { "type": "array", "items": { "type": "object" } },
        "howto": { "type": "array", "items": { "type": "object" } },
        "quiz": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

